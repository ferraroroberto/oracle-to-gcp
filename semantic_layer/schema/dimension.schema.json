{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dimension.schema.json",
  "title": "Dimension — something to break a metric down by",
  "allOf": [{"$ref": "_common.schema.json#/$defs/governance"}],
  "required": ["bindings"],
  "unevaluatedProperties": false,
  "properties": {
    "kind": {"const": "dimension"},
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {"allOf": [{"$ref": "_common.schema.json#/$defs/binding"}], "required": ["key"]}
    },
    "levels": {
      "description": "Optional hierarchy, finest first; each level has its own expression per platform.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "expressions"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "expressions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {"legacy": {"type": "string"}, "cloud": {"type": "string"}}
          }
        }
      }
    },
    "checks": {"type": "array", "items": {"$ref": "_common.schema.json#/$defs/check"}}
  }
}
