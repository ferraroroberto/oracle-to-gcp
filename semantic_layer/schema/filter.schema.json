{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "filter.schema.json",
  "title": "Filter — a named, reusable predicate on one table",
  "allOf": [{"$ref": "_common.schema.json#/$defs/governance"}],
  "required": ["bindings"],
  "unevaluatedProperties": false,
  "properties": {
    "kind": {"const": "filter"},
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {"allOf": [{"$ref": "_common.schema.json#/$defs/binding"}], "required": ["filter"]}
    }
  }
}
