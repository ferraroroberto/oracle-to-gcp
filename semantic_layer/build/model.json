    "customer.active_buyer": {
      "data": {
        "ai_context": {
          "examples": [
            "how many customers do we have",
            "active customers by store"
          ],
          "instructions": "If the user says \"customer\" with no qualifier, ask whether they mean active customers (12-month buyers), any registered account, or marketing's campaign-reachable customers, showing each one's difference in one line.\n"
        },
        "anchors": [
          "anchor.monthly_pack.active_customers"
        ],
        "bindings": [
          {
            "filter": "{t}.ACCOUNT_STATUS = 'A' AND {t}.IS_STAFF = 0 AND {t}.LAST_PURCHASE_DATE >= ADD_MONTHS({t}.SNAPSHOT_DATE, -12)",
            "key": "CUSTOMER_ID",
            "platform": "legacy",
            "preferred": false,
            "source": "DWH.CUSTOMER_MONTHLY",
            "status": "legacy",
            "time_column": "SNAPSHOT_DATE"
          },
          {
            "filter": "{t}.account_status = 'A' AND {t}.is_staff = FALSE AND {t}.last_purchase_date >= DATE_SUB({t}.snapshot_date, INTERVAL 12 MONTH)",
            "key": "customer_id",
            "platform": "cloud",
            "preferred": true,
            "review_note": "reviewed 2026-10-03 by avery.lane: auto-transpile kept ADD_MONTHS (not a BigQuery function) and compared the BOOLEAN is_staff to 0 — fixed by hand",
            "source": "analytics.customer_monthly",
            "status": "active",
            "time_column": "snapshot_date"
          }
        ],
        "caveats": [
          "Snapshot table: always pin one snapshot_date; summing across months counts each customer up to 12 times.",
          "The 12-month window is the leadership-approved definition, shared with finance."
        ],
        "checks": [
          {
            "column": "CUSTOMER_ID",
            "must_be": 0,
            "type": "nullValues"
          },
          {
            "columns": [
              "CUSTOMER_ID",
              "SNAPSHOT_DATE"
            ],
            "must_be": 0,
            "type": "duplicateValues"
          },
          {
            "between": [
              600,
              1000
            ],
            "per": "SNAPSHOT_DATE",
            "type": "rowCount"
          },
          {
            "column": "ACCOUNT_STATUS",
            "type": "invalidValues",
            "valid_values": [
              "A",
              "C",
              "P"
            ]
          },
          {
            "column": "SNAPSHOT_DATE",
            "max_lag_days": 35,
            "type": "freshness"
          },
          {
            "measure": "COUNT(DISTINCT {entity.key})",
            "platforms": [
              "legacy",
              "cloud"
            ],
            "tolerance_pct": 0.1,
            "type": "reconcile"
          }
        ],
        "description": "Open account (status A) that is not a staff account and completed at least one purchase in the 12 months up to the snapshot date. Pending accounts (P) cannot buy yet and closed accounts (C) are excluded.\n",
        "grain": "one row per customer per month-end snapshot",
        "id": "customer.active_buyer",
        "kind": "entity",
        "last_reviewed": "2026-10-03",
        "name": "Active customer (bought in the last 12 months)",
        "not_to_be_confused_with": [
          {
            "difference": "every open or pending registered account, whether or not it ever bought",
            "id": "customer.any_account"
          },
          {
            "difference": "marketing's 6-month window, with no account-status or staff filter",
            "id": "customer.campaign_reachable"
          }
        ],
        "owner": {
          "steward": "avery.lane",
          "team": "core_analytics"
        },
        "provenance": {
          "confirmed_by": "avery.lane",
          "confirmed_on": "2026-10-03",
          "from": "queries/core_analytics_pilot.oracle.sql",
          "lines": [
            4,
            20
          ],
          "method": "harvest",
          "session": "2026-10-03-core-analytics"
        },
        "review_by": "2027-04-03",
        "status": "certified",
        "synonyms": [
          "customer",
          "client",
          "active customer",
          "active client",
          "buyer"
        ],
        "version": 1
      },
      "domain": "core_analytics",
      "kind": "entity",
      "path": "domains/core_analytics/entities/customer.active_buyer.yaml",
      "summary": "Open account (status A) that is not a staff account and completed at least one purchase in the 12 months up to the snapshot date",
      "used_by": [
        "anchor.monthly_pack.active_customers",
        "metric.customer_count",
