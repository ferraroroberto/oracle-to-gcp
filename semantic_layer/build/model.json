            "preferred": false,
            "source": "DWH.CUSTOMERS",
            "status": "legacy"
          }
        ],
        "caveats": [
          "Includes staff accounts; filter them out if the question is about real customers."
        ],
        "checks": [
          {
            "column": "CUSTOMER_ID",
            "must_be": 0,
            "type": "nullValues"
          },
          {
            "columns": [
