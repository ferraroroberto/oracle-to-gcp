    "customer.campaign_reachable": {
      "data": {
        "bindings": [
          {
            "filter": "{t}.last_purchase_date >= DATE_SUB({t}.snapshot_date, INTERVAL '6' MONTH)",
            "key": "customer_id",
            "platform": "cloud",
            "preferred": true,
            "source": "analytics.customer_monthly",
            "status": "active",
            "time_column": "snapshot_date"
          },
          {
            "filter": "{t}.LAST_PURCHASE_DATE >= ADD_MONTHS({t}.SNAPSHOT_DATE, -6)",
            "key": "CUSTOMER_ID",
            "platform": "legacy",
            "preferred": false,
            "review_note": "reviewed 2026-10-10 by sam.ortiz: auto-transpile produced DATE_SUB(x, '6', MONTH), which is not Oracle — fixed to ADD_MONTHS by hand",
            "source": "DWH.CUSTOMER_MONTHLY",
            "status": "legacy",
            "time_column": "SNAPSHOT_DATE"
          }
        ],
        "caveats": [
          "Includes closed and staff accounts — likely over-counts the reachable audience (open question)."
        ],
        "checks": [
          {
            "column": "customer_id",
            "must_be": 0,
            "type": "nullValues"
          },
          {
            "columns": [
              "customer_id",
              "snapshot_date"
            ],
            "must_be": 0,
            "type": "duplicateValues"
          },
          {
            "column": "snapshot_date",
            "max_lag_days": 35,
            "type": "freshness"
          },
          {
            "measure": "COUNT(DISTINCT {entity.key})",
            "platforms": [
              "legacy",
              "cloud"
            ],
            "tolerance_pct": 0.1,
            "type": "reconcile"
          }
        ],
        "description": "Customer with a completed purchase in the 6 months up to the snapshot date. Marketing's campaign rule. No account-status or staff filter (see open questions).\n",
        "grain": "one row per customer per month-end snapshot",
        "id": "customer.campaign_reachable",
        "kind": "entity",
        "last_reviewed": "2026-10-10",
        "name": "Campaign-reachable customer (bought in the last 6 months)",
        "not_to_be_confused_with": [
          {
            "difference": "management-pack definition — 12 months, open accounts only, staff excluded",
            "id": "customer.active_buyer"
          },
          {
            "difference": "every open or pending account, whether or not it ever bought",
            "id": "customer.any_account"
          }
        ],
        "owner": {
          "steward": "sam.ortiz",
          "team": "marketing"
        },
        "provenance": {
          "confirmed_by": "sam.ortiz",
          "confirmed_on": "2026-10-10",
          "from": "queries/marketing_pilot.bigquery.sql",
          "lines": [
            3,
            11
          ],
          "method": "harvest",
          "open_questions": [
            "Should closed accounts (status C) be excluded? They cannot receive campaigns — CRM team to confirm.",
            "Should staff accounts be excluded, as in customer.active_buyer?"
          ],
          "session": "2026-10-10-marketing"
        },
        "review_by": "2026-11-10",
        "status": "reviewed",
        "synonyms": [
          "customer",
          "client",
          "reachable customer",
          "campaign audience",
          "recent buyer"
        ],
        "version": 1
      },
      "domain": "marketing",
